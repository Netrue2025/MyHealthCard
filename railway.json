{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm build" },
  "deploy": { "startCommand": "pnpm start", "healthcheckPath": "/health/ready", "healthcheckTimeout": 120, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 5 }
}
