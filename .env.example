# Server only. Never prefix these values with VITE_.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001
MONGODB_URI=mongodb://localhost:27017/netrue_health
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
EMAIL_PROVIDER=console
EMAIL_FROM=care@netrue.example
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_QUARANTINE=netrue-quarantine
S3_BUCKET_PRIVATE=netrue-private
S3_ACCESS_KEY_ID=local-development-only
S3_SECRET_ACCESS_KEY=local-development-only
SCANNER_HOST=localhost
SCANNER_PORT=3310
SCANNER_MODE=fail-closed
FEATURE_RESULT_COMPARISON=false
FEATURE_OCR=false
FEATURE_EMERGENCY_PROFILE=false
UPLOAD_DIR=./uploads
COOKIE_SECURE=false
# Server-only key restricted to Places API (New) and Geocoding API.
GOOGLE_PLACES_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:care@netrue.example
# Optional browser key restricted by HTTP referrer and Maps JavaScript API.
VITE_GOOGLE_MAPS_BROWSER_KEY=
